# V14PM Live Bot -- Hyperliquid (Portfolio Manager, Production)
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# -- Exchange: Hyperliquid Mainnet -------------------------------------------
# Generate at: https://app.hyperliquid.xyz/settings/api
# Scope required: Trade (the bot places and cancels orders)
HYPERLIQUID_API_KEY=your_hyperliquid_wallet_address
HYPERLIQUID_API_SECRET=your_hyperliquid_private_key

# -- Telegram Notifications --------------------------------------------------
# All PM bot events prefixed [V14-PM]
AIT_TG_TOKEN=your_telegram_bot_token
AIT_TG_CHAT_ID=your_telegram_chat_id

# -- Fear & Greed Index (optional) -------------------------------------------
# CFGI_API_KEY=your_cfgi_api_key

# -- Database ----------------------------------------------------------------
# Path to candles.db. Set explicitly on Linux cloud server.
AIT_CANDLES_DB=/opt/ait/trading/spot/data/candles.db

# -- PM Scanner Data ---------------------------------------------------------
# Path to cycle_scanner.json produced by v14_cycle_scanner.
AIT_SCANNER_JSON=/opt/ait/docs/data/v14/cycle_scanner.json

# -- Bot Configuration -------------------------------------------------------
# Passed as CLI args at launch:
#   python -u -m trading.spot.run_v14_portfolio_live \
#     --capital 50000 --profile high --leverage 1.0 --exchange hyperliquid
