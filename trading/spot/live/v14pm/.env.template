# V14PM Live Bot — Aster DEX Perpetuals (Portfolio Manager, Production)
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# -- Exchange: Aster DEX (Perps) ---------------------------------------------
# Generate API key in Aster DEX wallet settings.
# Scope required: Trade (the bot places and cancels orders)
ASTER_API_KEY=your_aster_api_key
ASTER_API_SECRET=your_aster_api_secret

# -- Telegram Notifications --------------------------------------------------
# All PM bot events prefixed [V14-PM]
AIT_TG_TOKEN=your_telegram_bot_token
AIT_TG_CHAT_ID=your_telegram_chat_id

# -- Fear & Greed Index (optional) -------------------------------------------
# CFGI_API_KEY=your_cfgi_api_key

# -- Database ----------------------------------------------------------------
# Path to candles.db. Set explicitly on Linux cloud server.
# On Windows, defaults to trading/spot/data/candles.db relative to workspace.
AIT_CANDLES_DB=/opt/ait/trading/spot/data/candles.db

# -- Bot Configuration -------------------------------------------------------
# Passed as CLI args at launch:
#   python -B -u -m trading.spot.run_v14_portfolio_live_aster \
#     --capital 20000 --confirm --skip-backfill
